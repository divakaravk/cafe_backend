{
  "name": "cafe-backend",
  "version": "0.1.0",
  "private": true,
  "description": "RasaBhojan / CafePOS — Node.js + MySQL API (docs/backend-migration/PLAN.md)",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:from-supabase": "tsx scripts/migrate-from-supabase.ts",
    "verify-migration": "tsx scripts/verify-migration.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "loadtest": "tsx scripts/loadtest.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@node-rs/argon2": "^2.0.2",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "@fastify/static": "^10.1.4",
    "mysql2": "^3.11.4",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "autocannon": "^8.0.0",
    "mysql-memory-server": "^1.16.0",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
