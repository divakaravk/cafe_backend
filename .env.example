NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cafe
DB_POOL_SIZE=20

# 32+ random bytes, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-32-bytes
ACCESS_TTL=30m
REFRESH_TTL_DAYS=30

CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# RBAC starts in log-only mode (Phase 8 of docs/backend-migration/PLAN.md flips this
# to true after comparing the audit log against real usage).
RBAC_ENFORCE=false
IDEMPOTENCY_TTL_HOURS=24

STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
PUBLIC_ASSET_BASE_URL=http://localhost:3000/uploads

# Optional — company-registration OTP push (docs/backend-migration/PLAN.md Phase 5).
# Leave unset to run with push disabled (registration still works; the owner just
# won't get a phone notification).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
